<%--
  Fragmento compartido: resultado de una auditoría.
  Lo incluyen evaluarRepositorio.jsp (auditoría general) y DetalleAsignacionJSP.jsp
  (auditoría de asignación) para que ambos flujos muestren la misma salida.

  Variables requeridas en la página que lo incluye:
    - resultado    (com.gr4.owlaudit.dto.ResultadoDTO, no nulo)
    - deudaTecnica (com.gr4.owlaudit.dto.DeudaTecnicaDTO, puede ser nulo)
--%>
<%
    boolean resAprobada = com.gr4.owlaudit.model.Auditoria.DICTAMEN_APROBADA.equals(resultado.getDictamen());
    double resUmbral = resultado.getUmbralAprobacion();
    String resUmbralTexto = (resUmbral == Math.floor(resUmbral))
            ? String.valueOf((long) resUmbral)
            : String.valueOf(resUmbral);
%>
<p class="text-md mb-05">
    <strong>Puntaje Obtenido:</strong> <%= resultado.getPuntajeObtenido() %> / <%= resultado.getPuntajeMaximo() %> pts
</p>
<p class="text-md mb-05">
    <strong>Cumplimiento de Calidad:</strong> <%= resultado.getPorcentaje() %> %
</p>
<p class="text-md mb-05">
    <strong>Umbral Requerido:</strong> <%= resUmbralTexto %> %
</p>
<p class="text-md mb-1 mt-05">
    <strong>Dictamen Final:</strong>
    <% if (resAprobada) { %>
        <span class="badge badge-corregido" style="font-size: 0.95rem; padding: 0.25rem 0.65rem;">✓ <%= com.gr4.owlaudit.model.Auditoria.DICTAMEN_APROBADA %></span>
    <% } else { %>
        <span class="badge badge-persistente" style="font-size: 0.95rem; padding: 0.25rem 0.65rem;">✗ <%= com.gr4.owlaudit.model.Auditoria.DICTAMEN_NO_APROBADA %></span>
    <% } %>
</p>

<% if (resultado.getDetalles() != null && !resultado.getDetalles().isEmpty()) { %>
    <h3 class="mt-15 mb-05 text-primary">📋 Desglose de Reglas Evaluadas y Hallazgos</h3>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Regla Técnica</th>
                    <th>Estado</th>
                    <th>Puntos</th>
                    <th>Severidad</th>
                    <th>Evidencia</th>
                    <th>Recomendación</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody>
                <% for (com.gr4.owlaudit.dto.ResultadoDTO.DetalleResultadoDTO resDet : resultado.getDetalles()) { %>
                    <tr>
                        <td><strong><%= HtmlUtil.escape(resDet.getNombreRegla()) %></strong></td>
                        <td>
                            <% if (resDet.isCumple()) { %>
                                <span class="badge badge-corregido">✓ Cumple</span>
                            <% } else { %>
                                <span class="badge badge-persistente">✗ Incumple</span>
                            <% } %>
                        </td>
                        <td><%= resDet.getPuntosObtenidos() %> / <%= resDet.getPonderacion() %> pts</td>
                        <td>
                            <% if (resDet.getNivelSeveridad() != null) { %>
                                <span class="badge badge-<%= resDet.getNivelSeveridad().name().toLowerCase() %>"><%= resDet.getNivelSeveridad().name() %></span>
                            <% } else { %>
                                —
                            <% } %>
                        </td>
                        <td class="col-evidence"><%= HtmlUtil.escape(resDet.getEvidencia() != null ? resDet.getEvidencia() : "—") %></td>
                        <td class="col-recommendation"><%= HtmlUtil.escape(resDet.getRecomendacion() != null ? resDet.getRecomendacion() : "—") %></td>
                        <td class="text-center">
                            <% if (!resDet.isCumple() && resDet.getHallazgoId() != null) { %>
                                <a class="btn-feedback"
                                   href="${pageContext.request.contextPath}/retroalimentacion?accion=solicitar&hallazgoId=<%= resDet.getHallazgoId() %>&reglaNombre=<%= java.net.URLEncoder.encode(resDet.getNombreRegla(), "UTF-8") %>&severidad=<%= resDet.getNivelSeveridad() != null ? resDet.getNivelSeveridad().name() : "ALTA" %>&evidencia=<%= java.net.URLEncoder.encode(resDet.getEvidencia() != null ? resDet.getEvidencia() : "", "UTF-8") %>">
                                    💬 Solicitar Feedback
                                </a>
                            <% } else { %>
                                <span class="text-muted text-sm">—</span>
                            <% } %>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
<% } %>

<%-- ===== BLOQUE: Deuda Tecnica Estimada ===== --%>
<% if (deudaTecnica != null) { %>
<div class="deuda-container">

    <h3 class="deuda-header">
        &#128336; Deuda T&eacute;cnica Estimada
    </h3>

    <div class="deuda-grid">
        <%-- ALTA --%>
        <div class="deuda-card deuda-card-alta">
            <div class="deuda-num">
                <%= deudaTecnica.getCantidadAlta() %>
            </div>
            <div class="deuda-lbl">
                Hallazgos ALTA
            </div>
            <div class="deuda-min">
                <%= deudaTecnica.getCantidadAlta() * 120 %> min
            </div>
        </div>

        <%-- MEDIA --%>
        <div class="deuda-card deuda-card-media">
            <div class="deuda-num">
                <%= deudaTecnica.getCantidadMedia() %>
            </div>
            <div class="deuda-lbl">
                Hallazgos MEDIA
            </div>
            <div class="deuda-min">
                <%= deudaTecnica.getCantidadMedia() * 60 %> min
            </div>
        </div>

        <%-- BAJA --%>
        <div class="deuda-card deuda-card-baja">
            <div class="deuda-num">
                <%= deudaTecnica.getCantidadBaja() %>
            </div>
            <div class="deuda-lbl">
                Hallazgos BAJA
            </div>
            <div class="deuda-min">
                <%= deudaTecnica.getCantidadBaja() * 30 %> min
            </div>
        </div>

        <%-- Total --%>
        <div class="deuda-card deuda-card-total">
            <div class="deuda-num">
                <%= deudaTecnica.getTiempoFormateado() %>
            </div>
            <div class="deuda-lbl">
                Tiempo total estimado
            </div>
            <div class="deuda-min">
                <%= deudaTecnica.getTotalMinutos() %> minutos
            </div>
        </div>
    </div>

    <p class="deuda-footer">
        &#9432; El tiempo estimado considera: ALTA = 120 min, MEDIA = 60 min, BAJA = 30 min por hallazgo.
    </p>
</div>
<% } %>
<%-- ===== FIN: Deuda Tecnica Estimada ===== --%>
