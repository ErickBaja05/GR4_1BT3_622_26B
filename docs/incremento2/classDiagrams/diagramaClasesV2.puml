@startuml classDiagrams_inc2
skinparam style strictuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false
skinparam classAttributeIconSize 0

' ========================================================
' ESTILOS VISUALES Y PALETA DE COLORES POR CAPAS
' ========================================================
skinparam class {
    BackgroundColor #F8FAFC
    BorderColor #1D4ED8
    BorderThickness 1.2
    HeaderBackgroundColor #EEF2FF
}

skinparam package {
    BackgroundColor #FAFAFC
    BorderColor #94A3B8
    BorderThickness 1.0
    FontStyle bold
    FontSize 12
}

title Diagrama de Clases Unificado — Incremento 2: Seguimiento Evolutivo y Retroalimentación Colaborativa\n(Arquitectura MVC + N-Capas con Flujo Vertical y Código de Colores)

' ========================================================
' 1. CAPA WEB / SERVLETS (ENTRADA AL SISTEMA)
' ========================================================
package "com.gr4.owlaudit.servlet" {
    class ProyectoServlet {
        - proyectoService : ProyectoService
        # doGet() : void
        # doPost() : void
    }

    class ReglaServlet {
        - reglaService : ReglaService
        # doGet() : void
        # doPost() : void
    }

    class AuditoriaServlet {
        - auditoriaService : AuditoriaService
        # doGet() : void
        # doPost() : void
    }

    class EvolucionServlet {
        - evolucionService : EvolucionService
        # doGet() : void
        # doPost() : void
    }

    class RetroalimentacionServlet {
        - retroalimentacionService : RetroalimentacionService
        # doGet() : void
        # doPost() : void
    }
}

' ========================================================
' 2. CAPA DE SERVICIOS (LÓGICA DE NEGOCIO)
' ========================================================
package "com.gr4.owlaudit.service" {
    ' Interfaces
    interface ProyectoService {
        + registrarProyecto() : void
        + validarEnlace() : void
    }

    interface ReglaService {
        + registrarReglaEvaluacionTecnica() : void
        + validarSintaxisYFormato() : void
    }

    interface AuditoriaService {
        + prepararAuditoria() : ResumenAuditoriaDTO
        + ejecutarAuditoria() : ResultadoAuditoriaDTO
        + calcularPuntajeMaximo() : int
        + calcularPuntaje() : void
    }

    interface EvolucionService {
        + listarHistorial() : List
        + compararAuditorias() : EvolucionDTO
    }

    interface RetroalimentacionService {
        + solicitarRevision() : void
        + atenderRetroalimentacion() : boolean
    }

    interface NotificacionService {
        + notificarEstudiante() : void
    }

    ' Implementaciones
    class ProyectoServiceImpl implements ProyectoService {
        - proyectoDAO : ProyectoDAO
        + registrarProyecto() : void
        + validarEnlace() : void
    }

    class ReglaServiceImpl implements ReglaService {
        - reglaDAO : ReglaDAO
        + registrarReglaEvaluacionTecnica() : void
        + validarSintaxisYFormato() : void
    }

    class AuditoriaServiceImpl implements AuditoriaService {
        - proyectoDAO : ProyectoDAO
        - reglaDAO : ReglaDAO
        - auditoriaDAO : AuditoriaDAO
        - gitHubClient : GitHubClient
        - evaluadorFactory : EvaluadorReglaFactory
        + prepararAuditoria() : ResumenAuditoriaDTO
        + ejecutarAuditoria() : ResultadoAuditoriaDTO
        + calcularPuntajeMaximo() : int
        + calcularPuntaje() : void
    }

    class EvolucionServiceImpl implements EvolucionService {
        - auditoriaDAO : AuditoriaDAO
        + listarHistorial() : List
        + compararAuditorias() : EvolucionDTO
        - convertirAResumen() : List
        - ordenarPorFecha() : Auditoria[]
        - calcularVariacion() : double[]
        - clasificarHallazgo() : EstadoEvolucionEnum
        - contarPorEstado() : Map
    }

    class RetroalimentacionServiceImpl implements RetroalimentacionService {
        - retroalimentacionDAO : RetroalimentacionDAO
        - notificacionService : NotificacionService
        + solicitarRevision() : void
        + atenderRetroalimentacion() : boolean
        - validarRespuesta() : void
    }

    class NotificacionServiceImpl implements NotificacionService {
        + notificarEstudiante() : void
    }
}

' ========================================================
' 3. CAPA DE ACCESO A DATOS (DAOs)
' ========================================================
package "com.gr4.owlaudit.dao" {
    interface ProyectoDAO <<DAO>> {
        + guardar() : void
        + buscarPorId() : Proyecto
    }

    interface ReglaDAO <<DAO>> {
        + existePorNombre() : boolean
        + guardar() : void
        + listarActivas() : List
    }

    interface AuditoriaDAO <<DAO>> {
        + guardar() : void
        + buscarPorId() : Auditoria
        + listarPorProyecto() : List
        + buscarConResultados() : Auditoria
    }

    interface RetroalimentacionDAO <<DAO>> {
        + guardar() : void
        + buscarPorId() : Retroalimentacion
        + buscarPorHallazgoId() : Retroalimentacion
        + actualizar() : boolean
    }

    class ProyectoDAOImpl implements ProyectoDAO {
        + guardar() : void
        + buscarPorId() : Proyecto
    }

    class ReglaDAOImpl implements ReglaDAO {
        + existePorNombre() : boolean
        + guardar() : void
        + listarActivas() : List
    }

    class AuditoriaDAOImpl implements AuditoriaDAO {
        + guardar() : void
        + buscarPorId() : Auditoria
        + listarPorProyecto() : List
        + buscarConResultados() : Auditoria
    }

    class RetroalimentacionDAOImpl implements RetroalimentacionDAO {
        + guardar() : void
        + buscarPorId() : Retroalimentacion
        + buscarPorHallazgoId() : Retroalimentacion
        + actualizar() : boolean
    }
}

' ========================================================
' 4. SUBSISTEMAS AUXILIARES (STRATEGY & CLIENTE EXTERNO)
' ========================================================
package "com.gr4.owlaudit.reglas.strategy" {
    class EvaluadorReglaFactory <<Factory>> {
        + obtenerEvaluador() : EvaluadorReglaStrategy
    }

    interface EvaluadorReglaStrategy <<Strategy>> {
        + evaluar() : boolean
    }

    class EvaluadorPresenciaArchivo implements EvaluadorReglaStrategy {
        + evaluar() : boolean
    }

    class EvaluadorRestriccionArchivos implements EvaluadorReglaStrategy {
        + evaluar() : boolean
    }

    class EvaluadorEstructuraCarpetas implements EvaluadorReglaStrategy {
        + evaluar() : boolean
    }
}

package "com.gr4.owlaudit.client" {
    class GitHubClient <<Client API>> {
        + obtenerEstructura() : List
    }
}

' ========================================================
' 5. CAPA DE DOMINIO / MODELO (ENTIDADES Y ENUMS)
' ========================================================
package "com.gr4.owlaudit.model" {
    class Proyecto <<Entity>> {
        - id : Long
        - nombre : String
        - urlGithub : String
        - estudianteId : Long
        - fechaRegistro : LocalDateTime
        + getId() : Long
        + getNombre() : String
        + getUrlGithub() : String
        + getEstudianteId() : Long
    }

    class Regla <<Entity>> {
        - id : Long
        - tipoMotor : TipoMotorEnum
        - nombreRepresentativo : String
        - descripcionDetallada : String
        - parametroExacto : String
        - nivelSeveridad : NivelSeveridadEnum
        - ponderacion : int
        - activa : boolean
        + getId() : Long
        + getTipoMotor() : TipoMotorEnum
        + getNombreRepresentativo() : String
        + getPonderacion() : int
        + isActiva() : boolean
    }

    class Auditoria <<Entity>> {
        - id : Long
        - fechaHora : LocalDateTime
        - usuarioId : Long
        - puntajeObtenido : int
        - puntajeMaximo : int
        - porcentaje : double
        - proyecto : Proyecto
        - resultados : List
        + getId() : Long
        + agregarResultado() : void
        + calcularPuntaje() : void
        + getResultados() : List
    }

    class ResultadoRegla <<Entity>> {
        - id : Long
        - cumple : boolean
        - puntosObtenidos : int
        - regla : Regla
        - auditoria : Auditoria
        - hallazgo : Hallazgo
        + isCumple() : boolean
        + getPuntosObtenidos() : int
        + getRegla() : Regla
        + getHallazgo() : Hallazgo
    }

    class Hallazgo <<Entity>> {
        - id : Long
        - nivelSeveridad : NivelSeveridadEnum
        - evidencia : String
        - recomendacion : String
        - resultadoRegla : ResultadoRegla
        - retroalimentacion : Retroalimentacion
        + getNivelSeveridad() : NivelSeveridadEnum
        + getEvidencia() : String
        + getRecomendacion() : String
        + getRetroalimentacion() : Retroalimentacion
    }

    class Retroalimentacion <<Entity>> {
        - id : Long
        - justificacion : String
        - fechaSolicitud : LocalDateTime
        - estado : EstadoRetroEnum
        - respuestaTecnica : String
        - fechaRespuesta : LocalDateTime
        - estudianteId : Long
        - hallazgo : Hallazgo
        + getId() : Long
        + getJustificacion() : String
        + getEstado() : EstadoRetroEnum
        + getRespuestaTecnica() : String
        + setRespuestaTecnica() : void
        + setEstado() : void
        + setFechaRespuesta() : void
    }

    enum NivelSeveridadEnum {
        ALTA
        MEDIA
        BAJA
    }

    enum TipoMotorEnum {
        PRESENCIA_ARCHIVO
        RESTRICCION_ARCHIVOS
        ESTRUCTURA_CARPETAS
    }

    enum EstadoRetroEnum {
        PENDIENTE
        ATENDIDA
    }

    enum EstadoEvolucionEnum {
        NUEVO
        PERSISTENTE
        CORREGIDO
    }
}

' ========================================================
' 6. CAPA DE TRANSFERENCIA (DTOs - PANEL LATERAL INDEPENDIENTE)
' ========================================================
package "com.gr4.owlaudit.dto" {
    class NuevoProyectoDTO <<DTO>> {
        - nombre : String
        - urlGithub : String
        - estudianteId : Long
        + getNombre() : String
        + getUrlGithub() : String
        + getEstudianteId() : Long
    }

    class NuevaReglaDTO <<DTO>> {
        - tipoMotor : String
        - nombreRepresentativo : String
        - descripcionDetallada : String
        - parametroExacto : String
        - nivelSeveridad : String
        - ponderacion : int
        + getNombreRepresentativo() : String
    }

    class ResumenAuditoriaDTO <<DTO>> {
        - puntajeMaximo : int
        + getPuntajeMaximo() : int
    }

    class ResultadoAuditoriaDTO <<DTO>> {
        - puntajeObtenido : int
        - puntajeMaximo : int
        - porcentaje : double
        + getPuntajeObtenido() : int
    }

    class AuditoriaResumenDTO <<DTO>> {
        - id : Long
        - fechaHora : LocalDateTime
        - puntajeObtenido : int
        - puntajeMaximo : int
        - porcentaje : double
        + getId() : Long
    }

    class EvolucionDTO <<DTO>> {
        - auditoriaBase : AuditoriaResumenDTO
        - auditoriaComparada : AuditoriaResumenDTO
        - variacionPuntaje : int
        - variacionPorcentaje : double
        - totalNuevos : int
        - totalPersistentes : int
        - totalCorregidos : int
    }

    class SolicitudRetroalimentacionDTO <<DTO>> {
        - hallazgoId : Long
        - justificacion : String
        - estudianteId : Long
    }

    class AtenderRetroalimentacionDTO <<DTO>> {
        - idRetroalimentacion : Long
        - respuestaTecnica : String
        - estudianteId : Long
    }
}

' ========================================================
' DISPOSICIÓN ESTRUCTURAL Y ORDEN VISUAL VERTICAL
' ========================================================
ProyectoServlet -[hidden]down-> ProyectoService
ProyectoServiceImpl -[hidden]down-> ProyectoDAO
ProyectoDAOImpl -[hidden]down-> Proyecto

ProyectoService -[hidden]right-> NuevoProyectoDTO
ProyectoDAO -[hidden]right-> EvaluadorReglaFactory
EvaluadorReglaFactory -[hidden]right-> GitHubClient

' ========================================================
' RELACIONES CODIFICADAS POR COLOR
' ========================================================

' --------------------------------------------------------
' AZUL (#1E40AF): Web -> Servicios (Invocación vertical)
' --------------------------------------------------------
ProyectoServlet -[#1E40AF,bold]down-> ProyectoService : invoca
ReglaServlet -[#1E40AF,bold]down-> ReglaService : invoca
AuditoriaServlet -[#1E40AF,bold]down-> AuditoriaService : invoca
EvolucionServlet -[#1E40AF,bold]down-> EvolucionService : invoca
RetroalimentacionServlet -[#1E40AF,bold]down-> RetroalimentacionService : invoca

' --------------------------------------------------------
' VERDE (#047857): Servicios -> DAOs (Persistencia)
' --------------------------------------------------------
ProyectoServiceImpl -[#047857,bold]down-> ProyectoDAO : utiliza
ReglaServiceImpl -[#047857,bold]down-> ReglaDAO : utiliza
AuditoriaServiceImpl -[#047857,bold]down-> AuditoriaDAO : utiliza
AuditoriaServiceImpl -[#047857,bold]down-> ReglaDAO : utiliza
AuditoriaServiceImpl -[#047857,bold]down-> ProyectoDAO : utiliza
EvolucionServiceImpl -[#047857,bold]down-> AuditoriaDAO : utiliza
RetroalimentacionServiceImpl -[#047857,bold]down-> RetroalimentacionDAO : utiliza

' --------------------------------------------------------
' PÚRPURA (#7C3AED): Servicios -> Clientes / Strategy / Notificación
' --------------------------------------------------------
AuditoriaServiceImpl -[#7C3AED,bold]right-> GitHubClient : invoca
AuditoriaServiceImpl -[#7C3AED,bold]right-> EvaluadorReglaFactory : solicita
EvaluadorReglaFactory -[#7C3AED,bold]down-> EvaluadorReglaStrategy : crea
RetroalimentacionServiceImpl -[#7C3AED,bold]right-> NotificacionService : invoca

' --------------------------------------------------------
' DOMINIO: Relaciones entre Entidades
' --------------------------------------------------------
Auditoria -[#334155]down-> Proyecto : evalua
Auditoria "1" *-[#DC2626,bold]down- "many" ResultadoRegla : contiene
ResultadoRegla -[#334155]down-> Regla : verifica
ResultadoRegla "1" o-[#D97706,bold]down- "0..1" Hallazgo : genera
Hallazgo "1" o-[#EA580C,bold]down- "0..1" Retroalimentacion : genera

' Enumeraciones del Dominio
Retroalimentacion -[#B45309]down-> EstadoRetroEnum : estado
Regla -[#B45309]down-> TipoMotorEnum : tipo
Regla -[#B45309]down-> NivelSeveridadEnum : severidad
Hallazgo -[#B45309]down-> NivelSeveridadEnum : severidad

@enduml
