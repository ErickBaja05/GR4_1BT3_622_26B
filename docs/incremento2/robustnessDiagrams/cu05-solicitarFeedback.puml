@startuml
skinparam style strictuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false
skinparam ranksep 40
skinparam nodesep 50

skinparam boundary {
    BackgroundColor #F8FAFC
    BorderColor #2563EB
    BorderThickness 1.2
}
skinparam control {
    BackgroundColor #FEF3C7
    BorderColor #D97706
    BorderThickness 1.2
}
skinparam entity {
    BackgroundColor #DCFCE7
    BorderColor #16A34A
    BorderThickness 1.2
}

actor "Estudiante" as estudiante

package "CU05: Solicitar Retroalimentación" {
    boundary "Interfaz SolicitudRetroalimentacion" as UI_Retro
    control "Gestor Retroalimentacion" as C_Retro
    entity "Hallazgo" as E_Hallazgo
    entity "SolicitudRetroalimentacion" as E_SolicitudRetro
}

estudiante --> UI_Retro : Solicitar retroalimentación
UI_Retro --> C_Retro : Registrar solicitud
C_Retro --> E_Hallazgo : Verificar estado de revisión
C_Retro --> E_SolicitudRetro : Crear solicitud
@enduml