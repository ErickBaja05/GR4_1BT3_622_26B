@startuml
left to right direction
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundCorner 10
skinparam shadowing false

skinparam boundary {
    BackgroundColor #F8FAFC
    BorderColor #2563EB
    BorderThickness 1.2
}
skinparam control {
    BackgroundColor #FEF3C7
    BorderColor #D97706
    BorderThickness 1.2
}
skinparam entity {
    BackgroundColor #DCFCE7
    BorderColor #16A34A
    BorderThickness 1.2
}
skinparam actor {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    BorderThickness 1.2
}
skinparam arrow {
    Color #334155
    Thickness 1.2
}

actor "Usuario" as usuario

package "CU04: Consultar Evolución de Calidad" {
    boundary "Interfaz\nSolicitud" as bSol
    boundary "Vista\nHistorial" as bHistorial
    boundary "Vista\nEvolución" as bEvolucion

    control "Gestor\nEvolución" as cEvolucion

    entity "Auditoría" as eAud
    entity "Resultado Regla" as eRes
    entity "Hallazgo" as eHal
}

' Fase 1: Solicitar y ver historial
usuario -- bSol : Solicitar evolución
bSol --> cEvolucion : Iniciar consulta
cEvolucion --> eAud : Consultar historial
cEvolucion --> bHistorial : Mostrar auditorías

' Fase 2: Seleccionar y comparar
usuario -- bHistorial : Indicar dos auditorías
bHistorial --> cEvolucion : Procesar comparación

cEvolucion --> cEvolucion : Ordenar por fecha
cEvolucion --> eRes : Consultar resultados
cEvolucion --> cEvolucion : Calcular variación

cEvolucion --> eHal : Clasificar estado
cEvolucion --> cEvolucion : Contar hallazgos

cEvolucion --> bEvolucion : Mostrar evolución
@enduml
