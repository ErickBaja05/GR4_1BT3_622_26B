@startuml cu06_robustez
skinparam style strictuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false
skinparam ranksep 40
skinparam nodesep 50

skinparam boundary {
    BackgroundColor #F8FAFC
    BorderColor #2563EB
    BorderThickness 1.2
}
skinparam control {
    BackgroundColor #FEF3C7
    BorderColor #D97706
    BorderThickness 1.2
}
skinparam entity {
    BackgroundColor #DCFCE7
    BorderColor #16A34A
    BorderThickness 1.2
}
skinparam actor {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    BorderThickness 1.2
}

actor "Docente" as docente

package "CU06: Atender Retroalimentación" {
    boundary "Interfaz AtenderRetroalimentacion" as UI_Atender
    control "Gestor Retroalimentacion" as C_Retro
    entity "Retroalimentacion" as E_Retro
    entity "Hallazgo" as E_Hallazgo
}

docente --> UI_Atender : Seleccionar solicitud y suministrar respuesta técnica
UI_Atender --> C_Retro : Solicitar atención de retroalimentación
C_Retro --> E_Hallazgo : Consultar detalle del hallazgo
C_Retro --> E_Retro : Registrar respuesta técnica y actualizar estado
@enduml
