@startuml
left to right direction
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundCorner 10
skinparam shadowing false

skinparam boundary {
    BackgroundColor #F8FAFC
    BorderColor #2563EB
    BorderThickness 1.2
}
skinparam control {
    BackgroundColor #FEF3C7
    BorderColor #D97706
    BorderThickness 1.2
}
skinparam entity {
    BackgroundColor #DCFCE7
    BorderColor #16A34A
    BorderThickness 1.2
}
skinparam actor {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    BorderThickness 1.2
}
skinparam arrow {
    Color #334155
    Thickness 1.2
}

actor "Docente" as docente

package "CU06: Atender Retroalimentación" {
    boundary "Vista Solicitudes\nPendientes" as bLista
    boundary "Formulario\nRespuesta" as bForm
    boundary "Mensaje\nError" as bError
    boundary "Mensaje\nÉxito" as bExito

    control "Gestor\nRetroalimentación" as cRetro
    entity "Hallazgo" as eHal
    entity "Solicitud" as eSol
}

' Trazabilidad con el flujo de actividades
docente -- bLista : Consultar solicitudes pendientes
docente -- bLista : Seleccionar solicitud a responder
bLista --> cRetro : Cargar detalle
cRetro --> eHal : Examinar informacion del hallazgo

docente -- bForm : Redactar orientacion tecnica
bForm --> cRetro : Procesar respuesta

' Trazabilidad con las bifurcaciones y resultados
cRetro --> bError : [Inválida] Informar error en la redaccion
cRetro --> eSol : [Válida] Registrar orientacion tecnica en la solicitud
cRetro --> eSol : Marcar solicitud como atendida
cRetro --> bExito : Notificar orientacion tecnica al estudiante

@enduml
