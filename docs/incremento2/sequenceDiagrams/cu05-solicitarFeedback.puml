@startuml
skinparam style strictuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false

skinparam maxMessageSize 130
skinparam ParticipantPadding 10
skinparam BoxPadding 10

skinparam participant {
    BackgroundColor #F0F7FF
    BorderColor #1D4ED8
    BorderThickness 1.2
    FontColor #0F172A
    FontStyle bold
}

skinparam actor {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    BorderThickness 1.2
    FontColor #0F172A
}

skinparam sequence {
    LifeLineBackgroundColor #DBEAFE
    LifeLineBorderColor #2563EB
    ArrowColor #1D4ED8
    ArrowThickness 1.2
}

autonumber "<b>[00]</b>"

actor "estudiante" as estudiante
participant "servlet :\nRetroalimentacionServlet" as servlet
participant "servicio :\nRetroalimentacionServiceImpl" as service
participant "dao :\nRetroalimentacionDAOImpl" as dao
participant "solicitud :\nSolicitudRetroalimentacion" as solicitud

' 1. El estudiante envía la solicitud vía POST desde la interfaz
estudiante -> servlet : doPost(\n  request,\n  response)
activate servlet

' 2. El Servlet construye internamente el DTO desde los parámetros HTTP
servlet -> servlet : dto = extraerParametros(\n  request)

' 3. Se invoca el servicio pasando el DTO
servlet -> service : solicitarRevision(\n  dto,\n  estudianteId)
activate service

' 4. Se verifica si el hallazgo ya tiene revisión previa
service -> dao : buscarPorHallazgoId(\n  dto.getHallazgoId())
activate dao
dao --> service : solicitudExistente
deactivate dao

alt ¿Sin solicitud previa (null)?
    ' 5. Instanciación y guardado de la nueva solicitud
    create solicitud
    service -> solicitud : new(\n  dto.getHallazgoId(),\n  dto.getJustificacion())

    service -> dao : guardar(\n  solicitud)
    activate dao
    dao --> service : return (void)
    deactivate dao

    service --> servlet : return (void)
    deactivate service

    ' 6. Respuesta mediante forward
    servlet --> estudiante : forward(\n  "mensajeExito")
else ¿Ya existe solicitud en revisión?
    service --> servlet : throw ExcepcionNegocio(\n  "Hallazgo en revisión")
    servlet --> estudiante : forward(\n  "mensajeError")
end
deactivate servlet

@enduml