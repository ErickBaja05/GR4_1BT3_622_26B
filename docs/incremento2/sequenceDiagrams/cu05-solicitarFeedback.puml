@startuml
skinparam style strictuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false

' --- AJUSTES PARA COMPACTAR HORIZONTALMENTE ---
' Define un ancho máximo en píxeles antes de hacer salto de línea en los mensajes
skinparam maxMessageSize 180
' Agrupa participantes o ajusta espacio si es necesario
skinparam SequenceParticipantPadding 10
skinparam SequenceBoxPadding 5

skinparam participant {
    BackgroundColor #F0F7FF
    BorderColor #1D4ED8
    BorderThickness 1.2
    FontColor #0F172A
    FontStyle bold
}

skinparam actor {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    BorderThickness 1.2
    FontColor #0F172A
}

skinparam sequence {
    LifeLineBackgroundColor #DBEAFE
    LifeLineBorderColor #2563EB
    ArrowColor #1D4ED8
    ArrowThickness 1.2
}

autonumber "<b>[00]</b>"

' Nombres con saltos de línea en los participantes largos
actor "estudiante :\nEstudiante" as estudiante
participant "vista :\nreporteAuditoria.jsp" as jsp
participant "servlet :\nRetroalimentacionServlet" as servlet
participant "dto :\nSolicitudRetroDTO" as dto
participant "servicio :\nRetroalimentacionServiceImpl" as service
participant "dao :\nRetroalimentacionDAOImpl" as dao
participant "solicitud :\nSolicitudRetroalimentacion" as solicitud

estudiante -> jsp : redactarJustificacion\n(hallazgoId, justificacionTexto)
activate jsp

jsp -> servlet : doPost(request, response)
activate servlet

servlet -> servlet : extraerParametros\n(request)

create dto
servlet -> dto : new(hallazgoId,\njustificacionTexto)

servlet -> service : solicitarRevision\n(dto, estudianteId)
activate service

' Validación de existencia de revisión previa
service -> dao : buscarPorHallazgoId\n(dto.getHallazgoId())
activate dao
dao --> service : solicitudExistente\n(null)
deactivate dao

alt ¿Solicitud previa no existe (null)?
    create solicitud
    service -> solicitud : new(hallazgoId, dto.getJustificacionEstudiante(),\nEstadoRetroEnum.PENDIENTE)

    service -> dao : guardar(solicitud)
    activate dao
    dao --> service : return (void)
    deactivate dao

    service --> servlet : return (void)
    deactivate service

    servlet -> servlet : setAttribute("mensajeConfirmacion",\n"Solicitud enviada exitosamente")
    servlet -> jsp : forward(request, response)
    deactivate servlet

    jsp --> estudiante : renderizarMensajeExito\n("Solicitud enviada exitosamente")
else ¿Existe una solicitud en revisión?
    service --> servlet : throw ExcepcionNegocio\n("El hallazgo ya tiene una solicitud...")
    servlet -> jsp : forwardConError\n("El hallazgo ya está en revisión")
    jsp --> estudiante : renderizarMensajeError\n("En revisión")
end
deactivate jsp

@enduml