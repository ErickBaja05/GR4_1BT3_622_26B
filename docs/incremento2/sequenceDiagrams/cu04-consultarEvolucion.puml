@startuml cu04_secuencia_diseno
title CU04 Consultar evolución de calidad — Diagrama de secuencia (diseño)

autonumber
skinparam sequenceMessageAlign center
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #333333
skinparam ParticipantBorderColor #333333
skinparam ParticipantBackgroundColor white
skinparam ActorBorderColor #333333
skinparam ActorBackgroundColor white
skinparam BoundaryBorderColor #333333
skinparam BoundaryBackgroundColor white
skinparam ControlBorderColor #333333
skinparam ControlBackgroundColor white
skinparam EntityBorderColor #333333
skinparam EntityBackgroundColor white
skinparam LifeLineBorderColor #333333
skinparam SequenceGroupBorderColor #333333
skinparam NoteBorderColor #333333
skinparam NoteBackgroundColor #FFFFF0

actor "Estudiante / Docente" as U
boundary "evolucion.jsp" as JSP1 <<JSP>>
boundary "resultadoEvolucion.jsp" as JSP2 <<JSP>>
control "EvolucionServlet" as SRV <<Servlet>>
control "EvolucionService" as SVC <<Service>>
entity "ProyectoDAO" as PDAO <<DAO>>
entity "AuditoriaDAO" as ADAO <<DAO>>

== Solicitar la consulta (flujo 1-2) ==
U -> JSP1 : Solicitar evolución del proyecto
activate JSP1
JSP1 -> SRV : doGet(request, response)
activate SRV
note right of SRV : proyectoId se lee del request
SRV -> SVC : listarHistorial(proyectoId) : List<AuditoriaResumenDTO>
activate SVC
SVC -> PDAO : buscarPorId(proyectoId) : Proyecto
activate PDAO
PDAO --> SVC : proyecto
deactivate PDAO
SVC -> ADAO : listarPorProyecto(proyectoId) : List<Auditoria>
activate ADAO
ADAO --> SVC : auditorias
deactivate ADAO
SVC -> SVC : convertirAResumen(auditorias) : List<AuditoriaResumenDTO>
SVC --> SRV : historialDTO
deactivate SVC
SRV -> JSP1 : forward(request, response)
deactivate SRV
note right of JSP1 : request.setAttribute("historial", historialDTO)
JSP1 -> U : Mostrar auditorías (fecha, puntaje, porcentaje)
deactivate JSP1

== Indicar las auditorías (flujo 3-4) ==
U -> JSP1 : Indicar dos auditorías
activate JSP1
JSP1 -> SRV : doPost(request, response)
deactivate JSP1
activate SRV
note right of SRV : auditoriaIdA y auditoriaIdB\nse leen del request
SRV -> SVC : compararAuditorias(auditoriaIdA, auditoriaIdB) : EvolucionDTO
activate SVC

== Obtener los resultados (flujo 5) ==
SVC -> ADAO : buscarConResultados(auditoriaIdA) : Auditoria
activate ADAO
ADAO --> SVC : auditoriaA
deactivate ADAO
SVC -> ADAO : buscarConResultados(auditoriaIdB) : Auditoria
activate ADAO
ADAO --> SVC : auditoriaB
deactivate ADAO
note right of ADAO : trae cada Auditoria con sus\nResultadoRegla, Regla y Hallazgo\n(relaciones del ORM)
SVC -> SVC : ordenarPorFecha(auditoriaA, auditoriaB)
note right of SVC : la más antigua es la base,\nla más reciente la comparada

== Calcular y clasificar (flujo 6-7) ==
SVC -> SVC : calcularVariacion(base, comparada)
create "EvolucionDTO" as DTO <<DTO>>
SVC -> DTO : new EvolucionDTO(base, comparada, variacionPuntaje, variacionPorcentaje)
loop por cada regla evaluada
  SVC -> SVC : clasificarHallazgo(resultadoBase, resultadoComparada) : EstadoEvolucion
  SVC -> DTO : agregarComparacion(regla, estado)
end
SVC -> DTO : contarPorEstado()

== Informar la evolución (flujo 8) ==
SVC --> SRV : evolucionDTO
deactivate SVC
SRV -> JSP2 : forward(request, response)
deactivate SRV
activate JSP2
note right of JSP2 : request.setAttribute("evolucion", evolucionDTO)
JSP2 -> U : Mostrar variación y hallazgos por estado
deactivate JSP2

@enduml
