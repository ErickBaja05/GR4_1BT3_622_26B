@startuml cu06_secuencia
skinparam style strictuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false

' Ajuste de espaciado y ancho de mensajes
skinparam maxMessageSize 180
skinparam ParticipantPadding 10
skinparam BoxPadding 10

skinparam participant {
    BackgroundColor #F0F7FF
    BorderColor #1D4ED8
    BorderThickness 1.2
    FontColor #0F172A
    FontStyle bold
}

skinparam actor {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    BorderThickness 1.2
    FontColor #0F172A
}

skinparam sequence {
    LifeLineBackgroundColor #DBEAFE
    LifeLineBorderColor #2563EB
    ArrowColor #1D4ED8
    ArrowThickness 1.2
}

autonumber "<b>[00]</b>"

actor "docente : Docente" as docente
participant "servlet : RetroalimentacionServlet" as servlet
participant "servicio : RetroalimentacionServiceImpl" as service
participant "dao : RetroalimentacionDAOImpl" as dao
participant "retro : Retroalimentacion" as retro
participant "notificacion : NotificacionServiceImpl" as notif

' 1. El docente envía la petición al Servlet
docente -> servlet : doPost(request, response)
activate servlet

' 2. El Servlet procesa la petición y delega al Servicio pasando el DTO
servlet -> servlet : extraerParametros(request)
servlet -> service : atenderRetroalimentacion(dto)
activate service

' 3. El Servicio valida los datos de la respuesta técnica
service -> service : validarRespuesta(dto.getRespuestaTecnica())

alt ¿Respuesta técnica válida?
    ' 4. El Servicio recupera la entidad para modificarla
    service -> dao : buscarPorId(dto.getIdRetroalimentacion())
    activate dao
    dao --> service : retroalimentacion
    deactivate dao

    ' 5. Actualización de atributos en la entidad de dominio
    service -> retro : setRespuestaTecnica(dto.getRespuestaTecnica())
    activate retro
    retro --> service : void
    deactivate retro

    service -> retro : setEstado(EstadoRetroEnum.ATENDIDA)
    activate retro
    retro --> service : void
    deactivate retro

    service -> retro : setFechaRespuesta(LocalDateTime.now())
    activate retro
    retro --> service : void
    deactivate retro

    ' 6. El Servicio persiste los cambios enviando el DTO hacia el DAO
    service -> dao : actualizar(dto)
    activate dao
    dao --> service : exito (true)
    deactivate dao

    ' 7. Notificación al estudiante responsable
    service -> notif : notificarEstudiante(dto.getEstudianteId(), "Retroalimentación atendida")
    activate notif
    notif --> service : void
    deactivate notif

    ' 8. Retorno y respuesta de éxito hacia el Servlet
    service --> servlet : true
    deactivate service

    servlet -> servlet : setAttribute("mensajeConfirmacion", "Retroalimentación atendida exitosamente")
    servlet --> docente : forward("exito.jsp")
    deactivate servlet

else ¿Respuesta técnica en blanco o inválida?
    service --> servlet : throw ExcepcionNegocio("La respuesta técnica no puede estar vacía")
    servlet --> docente : forwardConError("Error en la respuesta")
end

@enduml
