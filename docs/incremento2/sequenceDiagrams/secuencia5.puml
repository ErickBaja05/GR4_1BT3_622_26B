@startuml
skinparam style strictuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false

skinparam maxMessageSize 130
skinparam ParticipantPadding 10
skinparam BoxPadding 10

skinparam participant {
    BackgroundColor #F0F7FF
    BorderColor #1D4ED8
    BorderThickness 1.2
    FontColor #0F172A
    FontStyle bold
}

skinparam actor {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    BorderThickness 1.2
    FontColor #0F172A
}

skinparam sequence {
    LifeLineBackgroundColor #DBEAFE
    LifeLineBorderColor #2563EB
    ArrowColor #1D4ED8
    ArrowThickness 1.2
}

autonumber "<b>[00]</b>"

actor "estudiante : Estudiante" as estudiante
participant "servlet : RetroalimentacionServlet" as servlet
participant "servicio : RetroalimentacionServiceImpl" as service
participant "dao : SolicitudDAOImpl" as dao
participant "solicitud : SolicitudRetroalimentacion" as solicitud

' 1. El estudiante envía la solicitud vía POST (DTO implícito encapsulado por el Servlet)
estudiante -> servlet : doPost(request, response)
activate servlet

' 2. Trazabilidad exacta: "Solicitar retroalimentacion de hallazgo"
servlet -> service : solicitarRetroalimentacionDeHallazgo(solicitudDTO)
activate service

' 3. Trazabilidad exacta: "Verificar estado de revision del hallazgo"
service -> service : verificarEstadoDeRevisionDelHallazgo(solicitudDTO.getHallazgoId())

service -> dao : buscarPorHallazgoId(solicitudDTO.getHallazgoId())
activate dao
dao --> service : SolicitudRetroalimentacion (existente o null)
deactivate dao

alt ¿No tiene solicitud (null)?
    create solicitud
    service -> solicitud : new(solicitudDTO)

    ' 4. Trazabilidad exacta: "Crear solicitud de retroalimentacion"
    service -> dao : crearSolicitudDeRetroalimentacion(solicitud)
    activate dao
    dao --> service : void
    deactivate dao

    service --> servlet : void
    deactivate service

    ' 5. Trazabilidad exacta: "Notificar nueva solicitud"
    servlet --> estudiante : notificarNuevaSolicitud()

else ¿Ya tiene solicitud?
    service --> servlet : throw ExcepcionNegocio("Hallazgo en revisión")

    ' 6. Trazabilidad exacta: "Informar que el hallazgo esta en revision"
    servlet --> estudiante : informarQueElHallazgoEstaEnRevision()
end
deactivate servlet

@enduml
