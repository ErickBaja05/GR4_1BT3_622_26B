@startuml cu04_negocio_v3_completa
skinparam style strictuml
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #333333
skinparam SwimlaneBorderColor #333333
skinparam ArrowColor #333333

|Estudiante|
start
:Solicitar la evolución de
calidad de su proyecto;

|Docente|
if (¿Hay al menos dos auditorías registradas?) then ([No])
  :Informar que no hay
  auditorías para comparar;
  stop
else ([Sí])
endif
:Informar las auditorías registradas
(fecha, puntaje y porcentaje);

|Estudiante|
if (¿Continúa con la consulta?) then ([No])
  stop
else ([Sí])
endif
repeat
  |Estudiante|
  :Indicar dos auditorías
  del historial;
  |Docente|
backward :Informar que deben ser
dos auditorías distintas;
repeat while (¿Son la misma auditoría?) is ([Sí]) not ([No])

:Tomar la más antigua como base
y la más reciente como comparada;
:Consultar el resultado de cada
regla en ambas auditorías;
:Calcular la variación del
puntaje y del porcentaje;
if (¿Hay hallazgos en alguna auditoría?) then ([Sí])
  while (¿Quedan reglas por comparar?) is ([Sí])
    if (¿Cumplió en la auditoría base?) then ([Sí])
      if (¿Cumple en la auditoría comparada?) then ([No])
        :Clasificar el hallazgo como "Nuevo";
      else ([Sí])
      endif
    else ([No])
      if (¿Cumple en la auditoría comparada?) then ([Sí])
        :Clasificar el hallazgo como "Corregido";
      else ([No])
        :Clasificar el hallazgo como "Persistente";
      endif
    endif
  endwhile ([No])
  :Contar los hallazgos por estado;
  :Informar la evolución con
  los hallazgos por estado;
else ([No])
  :Informar la evolución
  sin hallazgos;
endif

|Estudiante|
:Recibir la evolución
de calidad;
stop

@enduml
