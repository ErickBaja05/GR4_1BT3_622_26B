@startuml cu06_actividades
skinparam style strictuml
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #333333
skinparam SwimlaneBorderColor #333333
skinparam ArrowColor #333333

title CU06 Atender retroalimentación de hallazgo\nDiagrama de actividades

|Docente|
start
:Iniciar sesión en el sistema;

|Sistema|
:Validar credenciales del Docente;

if (¿Credenciales válidas?) then (Sí)
else (No)
    :Mostrar mensaje de error\nde autenticación;
    stop
endif

:Mostrar panel principal del Docente;

|Docente|
:Acceder al módulo de\nretroalimentaciones pendientes;

|Sistema|
:Consultar solicitudes de\nretroalimentación con estado "Pendiente";

if (¿Existen solicitudes pendientes?) then (Sí)
    :Listar solicitudes pendientes\ncon información del hallazgo,\nestudiante, proyecto y auditoría;
else (No)
    :Mostrar mensaje\n"No hay solicitudes pendientes";
    stop
endif

|Docente|
repeat
    :Seleccionar una solicitud\nde retroalimentación;

    |Sistema|
    :Mostrar detalle de la solicitud:\n• Hallazgo asociado (regla, severidad, evidencia)\n• Comentario/duda del estudiante\n• Información del proyecto y auditoría;

    |Docente|
    :Revisar la información del hallazgo\ny la duda planteada por el estudiante;

    :Redactar respuesta técnica\ncon orientación y recomendaciones;

    if (¿Desea enviar la respuesta?) then (Sí)
        :Confirmar envío de la\nrespuesta técnica;

        |Sistema|
        if (¿Respuesta técnica válida?) then (Sí)
            :Registrar la respuesta del Docente\nen la Retroalimentación;

            :Actualizar estado de la\nRetroalimentación a "Atendida";

            :Notificar al Estudiante que\nsu solicitud fue atendida;

            :Mostrar mensaje de confirmación:\n"Retroalimentación enviada exitosamente";
        else (No)
            :Mostrar mensaje de error:\n"La respuesta no puede estar vacía";
        endif
    else (No)
        |Docente|
        :Cancelar redacción;
    endif

    |Docente|
repeat while (¿Atender otra solicitud?) is (Sí)
->No;

stop

@enduml
