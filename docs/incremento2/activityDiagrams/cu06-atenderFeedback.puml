@startuml cu06_actividades
skinparam style strictuml
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #333333
skinparam SwimlaneBorderColor #333333
skinparam ArrowColor #333333

title CU06 Atender retroalimentación de hallazgo\nDiagrama de actividades

|Docente|
|Estudiante|

|Docente|
start
:Revisar las solicitudes de retroalimentación\npendientes sobre hallazgos de auditoría;

if (¿Existen solicitudes pendientes?) then (Sí)
    repeat
        :Seleccionar una solicitud\nde retroalimentación;

        :Examinar la información del hallazgo\n(regla observada, severidad de la no conformidad\ny consulta técnica planteada por el estudiante);

        :Elaborar la orientación técnica y\nrecomendaciones de mejora pertinentes;

        if (¿Decide remitir la respuesta técnica?) then (Sí)
            :Registrar la orientación técnica\nen la retroalimentación;

            :Dar la solicitud por Atendida;

            :Hacer llegar la orientación técnica\nal estudiante responsable;

            |Estudiante|
            :Recibir la orientación técnica\ny pautas de solución brindadas;

            :Revisar las recomendaciones para\nsubsanar el hallazgo en el proyecto;

            |Docente|
        else (No)
            :Descartar el borrador\nde la respuesta;
        endif

    repeat while (¿Revisar otra solicitud pendiente?) is (Sí)
    ->No;
    stop
else (No)
    stop
endif

@enduml
