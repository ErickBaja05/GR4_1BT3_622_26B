@startuml
left to right direction

' ========================================================
' ESTILOS VISUALES (Paleta Azul Moderna y Bordes Curvos)
' ========================================================
skinparam roundCorner 15
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #94A3B8
    BorderThickness 1.5
    FontColor #0F172A
    FontStyle bold
    FontSize 14
}

skinparam actor {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    BorderThickness 1.5
    FontColor #1E293B
    FontSize 13
}

skinparam usecase {
    BackgroundColor #F0F7FF
    BorderColor #1D4ED8
    BorderThickness 1.5
    FontColor #0F172A
    FontSize 12
    RoundCorner 25
}

skinparam arrow {
    Color #334155
    Thickness 1.2
}

' ========================================================
' ACTORES
' ========================================================
actor :Docente: as docente
actor :Estudiante: as estudiante
actor :GitHub: <<Sistema Externo>> as github

' ========================================================
' LÍMITE DEL SISTEMA: INCREMENTO 1
' ========================================================
rectangle "OwlAudit - Incremento 1" {
    usecase "Registrar regla evaluación técnica" as cu01
    usecase "Registrar proyecto académico" as cu02
    usecase "Ejecutar auditoria calidad repositorio" as cu03
}

' ========================================================
' ASOCIACIONES
' ========================================================
docente -- cu01
estudiante -- cu02

' Ambos actores pueden ejecutar la auditoría
estudiante -- cu03
docente -- cu03

' Interacción con la API externa de GitHub para inspección
cu03 -- github

@enduml
