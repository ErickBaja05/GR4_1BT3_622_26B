@startuml
skinparam activity {
  BackgroundColor #FFF9C4
  BorderColor Black
  FontColor Black
  ArrowColor Black
  DiamondBackgroundColor #E1F5FE
  DiamondBorderColor Black
  DiamondFontColor Black
}

title CU03: Ejecutar auditoría de calidad

|Estudiante|
start
:Solicitar previa de auditoria;

|Docente|
:Consultar reglas de evaluacion vigentes;
if (¿Hay reglas vigentes?) then ([No])
  :Informar que no hay reglas;
  stop
else ([Sí])
endif
:Informar reglas y puntaje maximo;

|Estudiante|
if (¿Continúa con la auditoría?) then ([No])
  stop
else ([Sí])
endif
:Confirmar ejecucion de auditoria;

|Docente|
if (¿El repositorio es accesible?) then ([No])
  :Informar que no fue posible auditar;
  stop
else ([Sí])
endif
:Obtener estructura del repositorio;
while (¿Quedan reglas por revisar?) is ([Sí])
  :Evaluar cumplimiento de regla;
  if (¿Cumple la regla?) then ([Sí])
    :Asignar ponderacion completa;
  else ([No])
    :Registrar hallazgo de incumplimiento;
  endif
endwhile ([No])
:Calcular puntajes de la auditoria;
:Registrar auditoria en el historial;
:Informar resultado de la auditoria;

|Estudiante|
:Recibir resultado de la auditoria;
stop
@enduml
