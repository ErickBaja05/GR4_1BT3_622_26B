@startuml cu03_negocio_v3_completa
skinparam style strictuml
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #333333
skinparam SwimlaneBorderColor #333333
skinparam ArrowColor #333333

|Estudiante|
start
:Solicitar la auditoría
de su proyecto;

|Docente|
if (¿Hay reglas de evaluación vigentes?) then ([No])
  :Informar que no hay reglas
  de evaluación definidas;
  stop
else ([Sí])
endif
:Informar las reglas de evaluación
vigentes y el puntaje máximo;

|Estudiante|
if (¿Continúa con la auditoría?) then ([No])
  stop
else ([Sí])
endif
:Confirmar la auditoría;

|Docente|
if (¿El repositorio es accesible?) then ([No])
  :Informar que no fue posible
  auditar el proyecto;
  stop
else ([Sí])
endif
:Revisar la estructura del
repositorio del proyecto en GitHub;
while (¿Quedan reglas por revisar?) is ([Sí])
  if (¿El repositorio cumple la regla?) then ([Sí])
    :Asignar la ponderación de la regla;
  else ([No])
    :Asignar cero puntos a la regla;
    :Registrar un hallazgo con su
    severidad, evidencia y recomendación;
  endif
  :Anotar el resultado de la regla;
endwhile ([No])
:Calcular el puntaje obtenido,
el máximo y el porcentaje;
:Registrar la auditoría en el
historial del proyecto;
if (¿Se registraron hallazgos?) then ([Sí])
  :Informar el resultado
  con sus hallazgos;
else ([No])
  :Informar el resultado
  sin hallazgos;
endif

|Estudiante|
:Recibir el resultado
de la auditoría;
stop

@enduml
