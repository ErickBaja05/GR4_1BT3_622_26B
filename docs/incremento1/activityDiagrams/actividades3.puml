@startuml
skinparam style strictuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false

skinparam maxMessageSize 130
skinparam ParticipantPadding 10
skinparam BoxPadding 10

skinparam participant {
    BackgroundColor #F0F7FF
    BorderColor #1D4ED8
    BorderThickness 1.2
    FontColor #0F172A
    FontStyle bold
}

skinparam actor {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    BorderThickness 1.2
    FontColor #0F172A
}

skinparam sequence {
    LifeLineBackgroundColor #DBEAFE
    LifeLineBorderColor #2563EB
    ArrowColor #1D4ED8
    ArrowThickness 1.2
}

autonumber "<b>[00]</b>"

actor "estudiante : Estudiante" as estudiante
participant "servlet : AuditoriaServlet" as servlet
participant "servicio : AuditoriaServiceImpl" as service
participant "github : GitHubClient" as githubClient
participant "daoRegla : ReglaDAOImpl" as rDao
participant "daoAuditoria : AuditoriaDAOImpl" as aDao
participant "auditoria : Auditoria" as auditoria
actor "api : GitHub" as githubApi

== 1. Previa de Auditoría ==
estudiante -> servlet : doGet(request, response)
activate servlet

' El DTO está implícito y se pasa por firma garantizando su existencia en el Diagrama de Clases
servlet -> service : solicitarPreviaDeAuditoria(auditoriaDTO)
activate service

service -> rDao : consultarReglasDeEvaluacionVigentes()
activate rDao
rDao --> service : List<Regla>
deactivate rDao

service --> servlet : ResumenDTO
deactivate service

servlet --> estudiante : informarReglasYPuntajeMaximo()
deactivate servlet

== 2. Ejecución de Auditoría ==
estudiante -> servlet : doPost(request, response)
activate servlet

servlet -> service : confirmarEjecucionDeAuditoria(auditoriaDTO)
activate service

service -> githubClient : obtenerEstructuraDelRepositorio(auditoriaDTO.getUrl())
activate githubClient
githubClient -> githubApi : GET /repos/{owner}/{repo}/git/trees
activate githubApi
githubApi --> githubClient : JSON Tree
deactivate githubApi
githubClient --> service : List<String> rutas
deactivate githubClient

create auditoria
service -> auditoria : new()

loop por cada regla vigente
    service -> service : evaluarCumplimientoDeRegla(regla, rutas)

    alt ¿Cumple la regla?
        service -> auditoria : asignarPonderacionCompleta(regla)
    else ¿No cumple?
        service -> auditoria : registrarHallazgoDeIncumplimiento(regla)
    end
end

service -> service : calcularPuntajesDeLaAuditoria()

service -> aDao : registrarAuditoriaEnElHistorial(auditoria)
activate aDao
aDao --> service : void
deactivate aDao

service --> servlet : ResultadoDTO
deactivate service

servlet --> estudiante : informarResultadoDeLaAuditoria()
deactivate servlet
@enduml
