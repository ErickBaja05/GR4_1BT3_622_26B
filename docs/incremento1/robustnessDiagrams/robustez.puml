@startuml
left to right direction
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundCorner 10
skinparam shadowing false

skinparam boundary {
    BackgroundColor #F8FAFC
    BorderColor #2563EB
    BorderThickness 1.2
}
skinparam control {
    BackgroundColor #FEF3C7
    BorderColor #D97706
    BorderThickness 1.2
}
skinparam entity {
    BackgroundColor #DCFCE7
    BorderColor #16A34A
    BorderThickness 1.2
}
skinparam actor {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    BorderThickness 1.2
}
skinparam arrow {
    Color #334155
    Thickness 1.2
}

actor "Docente" as actorDocente

package "CU01: Registrar Regla Técnica" {
    boundary "Formulario de\nRegistro" as bForm
    boundary "Mensaje de\nConfirmación" as bExito
    boundary "Mensaje de\nError" as bError

    control "Validar\nFormato" as cValidar
    control "Verificar\nUnicidad" as cVerificar
    control "Registrar\nRegla" as cRegistrar

    entity "Regla" as eRegla
}

actorDocente -- bForm : Ingresar datos
bExito -- actorDocente : Mostrar éxito
bError -- actorDocente : Mostrar error

bForm --> cValidar : Enviar solicitud
cValidar --> bError : [Datos inválidos]
cValidar --> cVerificar : [Datos válidos]
cVerificar --> eRegla : Consultar existencia
cVerificar --> bError : [Nombre duplicado]
cVerificar --> cRegistrar : [Nombre disponible]
cRegistrar --> eRegla : Instanciar y guardar
cRegistrar --> bExito : Notificar éxito
@enduml
