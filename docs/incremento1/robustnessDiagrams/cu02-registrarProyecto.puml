@startuml
skinparam style strictuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false
skinparam ranksep 40
skinparam nodesep 50

skinparam boundary {
    BackgroundColor #F8FAFC
    BorderColor #2563EB
    BorderThickness 1.2
}
skinparam control {
    BackgroundColor #FEF3C7
    BorderColor #D97706
    BorderThickness 1.2
}
skinparam entity {
    BackgroundColor #DCFCE7
    BorderColor #16A34A
    BorderThickness 1.2
}

actor "Estudiante" as estudiante

package "CU02: Registrar Proyecto Académico" {
    boundary "Interfaz Formulario Proyecto" as InterfazProyecto
    control "Gestor Proyectos" as C_Proyecto
    entity "Proyecto Academico" as E_Proyecto
}

estudiante --> InterfazProyecto : escribirDatos(nombre, urlGithub)
InterfazProyecto --> C_Proyecto : solicitarRegistro
C_Proyecto --> C_Proyecto : validarEnlace
C_Proyecto --> E_Proyecto : crear y guardar proyecto 
@enduml