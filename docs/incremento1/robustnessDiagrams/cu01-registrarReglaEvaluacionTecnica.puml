@startuml
' Forzar orientación horizontal y motor de grafo (elimina las líneas de vida de secuencia)
left to right direction

skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundCorner 10
skinparam shadowing false

' ========================================================
' ESTILOS VISUALES BCE
' ========================================================
skinparam actor {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    FontColor #0F172A
}

skinparam boundary {
    BackgroundColor #F0F7FF
    BorderColor #1D4ED8
    FontColor #0F172A
}

skinparam control {
    BackgroundColor #EFF6FF
    BorderColor #1D4ED8
    FontColor #0F172A
}

skinparam entity {
    BackgroundColor #F8FAFC
    BorderColor #0F172A
    FontColor #0F172A
}

skinparam arrow {
    Color #2563EB
    Thickness 1.2
}

' ========================================================
' ELEMENTOS DEL MODELO DE ANÁLISIS
' ========================================================
actor "Docente" as actorDocente

boundary "Formulario de\nRegistro de Regla" as bForm
boundary "Mensaje de\nConfirmación" as bExito
boundary "Mensaje de\nError" as bError

control "Validar Formato\ny Sintaxis" as cValidar
control "Verificar Unicidad\nde Nombre" as cVerificar
control "Registrar\nRegla" as cRegistrar

entity "Regla" as eRegla

' ========================================================
' INTERACCIÓN ACTOR - FRONTERA (LÍMITES)
' ========================================================
actorDocente -- bForm : Ingresar datos
bExito -- actorDocente : Visualizar éxito
bError -- actorDocente : Visualizar error

' ========================================================
' FLUJO DE CONTROL Y LÓGICA DE NEGOCIO
' ========================================================
bForm --> cValidar : Enviar solicitud

' Bifurcación 1: Validación sintáctica
cValidar --> bError : [Datos inválidos]
cValidar --> cVerificar : [Datos válidos]

' Bifurcación 2: Verificación de unicidad con la Entidad
cVerificar --> eRegla : Consultar existencia
cVerificar --> bError : [Nombre duplicado]
cVerificar --> cRegistrar : [Nombre disponible]

' Persistencia y Notificación final
cRegistrar --> eRegla : Instanciar y guardar
cRegistrar --> bExito : Notificar éxito

@enduml
