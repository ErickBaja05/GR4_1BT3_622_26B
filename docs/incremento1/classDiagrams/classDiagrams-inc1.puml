@startuml classDiagrams_inc1
skinparam style strictuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false
skinparam classAttributeIconSize 0

skinparam class {
    BackgroundColor #F8FAFC
    BorderColor #1D4ED8
    BorderThickness 1.2
    ArrowColor #1D4ED8
    HeaderBackgroundColor #EEF2FF
}

title Diagrama de Clases Unificado — Incremento 1: Gestión de Reglas, Proyectos y Auditoría Base\n(Arquitectura MVC + N-Capas con Patrón Strategy)

' ========================================================
' CAPA WEB / SERVLETS
' ========================================================
package "com.gr4.owlaudit.web" {
    class ProyectoServlet <<Controller>> {
        - proyectoService : ProyectoService
        + doGet() : void
        + doPost() : void
    }

    class ReglaServlet <<Controller>> {
        - reglaService : ReglaService
        + doGet() : void
        + doPost() : void
    }

    class AuditoriaServlet <<Controller>> {
        - auditoriaService : AuditoriaService
        + doGet() : void
        + doPost() : void
    }
}

' ========================================================
' CAPA DE TRANSFERENCIA (DTOs)
' ========================================================
package "com.gr4.owlaudit.dto" {
    class NuevoProyectoDTO <<DTO>> {
        - nombre : String
        - urlGithub : String
        - estudianteId : Long
        + NuevoProyectoDTO()
        + getNombre() : String
        + getUrlGithub() : String
        + getEstudianteId() : Long
    }

    class NuevaReglaDTO <<DTO>> {
        - tipoMotor : String
        - nombreRepresentativo : String
        - descripcionDetallada : String
        - parametroExacto : String
        - nivelSeveridad : String
        - ponderacion : int
        + NuevaReglaDTO()
        + getTipoMotor() : String
        + getNombreRepresentativo() : String
        + getDescripcionDetallada() : String
        + getParametroExacto() : String
        + getNivelSeveridad() : String
        + getPonderacion() : int
    }

    class ResumenAuditoriaDTO <<DTO>> {
        - puntajeMaximo : int
        + ResumenAuditoriaDTO()
        + getPuntajeMaximo() : int
    }

    class ResultadoAuditoriaDTO <<DTO>> {
        - puntajeObtenido : int
        - puntajeMaximo : int
        - porcentaje : double
        + ResultadoAuditoriaDTO()
        + getPuntajeObtenido() : int
        + getPuntajeMaximo() : int
        + getPorcentaje() : double
    }
}

' ========================================================
' CAPA DE SERVICIOS (LÓGICA DE NEGOCIO)
' ========================================================
package "com.gr4.owlaudit.service" {
    interface ProyectoService <<Service>> {
        + registrarProyecto() : void
        + validarEnlace() : void
    }

    interface ReglaService <<Service>> {
        + registrarReglaEvaluacionTecnica() : void
        + validarSintaxisYFormato() : void
    }

    interface AuditoriaService <<Service>> {
        + prepararAuditoria() : ResumenAuditoriaDTO
        + ejecutarAuditoria() : ResultadoAuditoriaDTO
        + calcularPuntajeMaximo() : int
        + calcularPuntaje() : void
    }

    class ProyectoServiceImpl implements ProyectoService {
        - proyectoDAO : ProyectoDAO
        + registrarProyecto() : void
        + validarEnlace() : void
    }

    class ReglaServiceImpl implements ReglaService {
        - reglaDAO : ReglaDAO
        + registrarReglaEvaluacionTecnica() : void
        + validarSintaxisYFormato() : void
    }

    class AuditoriaServiceImpl implements AuditoriaService {
        - proyectoDAO : ProyectoDAO
        - reglaDAO : ReglaDAO
        - auditoriaDAO : AuditoriaDAO
        - gitHubClient : GitHubClient
        - evaluadorFactory : EvaluadorReglaFactory
        + prepararAuditoria() : ResumenAuditoriaDTO
        + ejecutarAuditoria() : ResultadoAuditoriaDTO
        + calcularPuntajeMaximo() : int
        + calcularPuntaje() : void
    }
}

' ========================================================
' CAPA DE ACCESO A DATOS (DAOs)
' ========================================================
package "com.gr4.owlaudit.dao" {
    interface ProyectoDAO <<DAO>> {
        + guardar() : void
        + buscarPorId() : Proyecto
    }

    interface ReglaDAO <<DAO>> {
        + existePorNombre() : boolean
        + guardar() : void
        + listarActivas() : List
    }

    interface AuditoriaDAO <<DAO>> {
        + guardar() : void
        + buscarPorId() : Auditoria
        + listarPorProyecto() : List
    }

    class ProyectoDAOImpl implements ProyectoDAO {
        + guardar() : void
        + buscarPorId() : Proyecto
    }

    class ReglaDAOImpl implements ReglaDAO {
        + existePorNombre() : boolean
        + guardar() : void
        + listarActivas() : List
    }

    class AuditoriaDAOImpl implements AuditoriaDAO {
        + guardar() : void
        + buscarPorId() : Auditoria
        + listarPorProyecto() : List
    }
}

' ========================================================
' PATRÓN STRATEGY: EVALUACIÓN DE REGLAS DE CALIDAD
' ========================================================
package "com.gr4.owlaudit.reglas.strategy" {
    class EvaluadorReglaFactory <<Factory>> {
        + obtenerEvaluador() : EvaluadorReglaStrategy
    }

    interface EvaluadorReglaStrategy <<Strategy>> {
        + evaluar() : boolean
    }

    class EvaluadorPresenciaArchivo implements EvaluadorReglaStrategy {
        + evaluar() : boolean
    }

    class EvaluadorRestriccionArchivos implements EvaluadorReglaStrategy {
        + evaluar() : boolean
    }

    class EvaluadorEstructuraCarpetas implements EvaluadorReglaStrategy {
        + evaluar() : boolean
    }
}

' ========================================================
' CLIENTE EXTERNO
' ========================================================
package "com.gr4.owlaudit.client" {
    class GitHubClient <<Client API>> {
        + obtenerEstructura() : List
    }
}

' ========================================================
' CAPA DE DOMINIO / MODELO (ENTIDADES)
' ========================================================
package "com.gr4.owlaudit.model" {
    class Auditoria <<Entity>> {
        - id : Long
        - fechaHora : LocalDateTime
        - usuarioId : Long
        - puntajeObtenido : int
        - puntajeMaximo : int
        - porcentaje : double
        - proyecto : Proyecto
        - resultados : List
        + getId() : Long
        + agregarResultado() : void
        + calcularPuntaje() : void
        + getResultados() : List
    }

    class ResultadoRegla <<Entity>> {
        - id : Long
        - cumple : boolean
        - puntosObtenidos : int
        - regla : Regla
        - auditoria : Auditoria
        - hallazgo : Hallazgo
        + isCumple() : boolean
        + getPuntosObtenidos() : int
        + getRegla() : Regla
        + getHallazgo() : Hallazgo
    }

    class Hallazgo <<Entity>> {
        - id : Long
        - nivelSeveridad : NivelSeveridadEnum
        - evidencia : String
        - recomendacion : String
        - resultadoRegla : ResultadoRegla
        + getNivelSeveridad() : NivelSeveridadEnum
        + getEvidencia() : String
        + getRecomendacion() : String
    }

    class Proyecto <<Entity>> {
        - id : Long
        - nombre : String
        - urlGithub : String
        - estudianteId : Long
        - fechaRegistro : LocalDateTime
        + getId() : Long
        + getNombre() : String
        + getUrlGithub() : String
        + getEstudianteId() : Long
    }

    class Regla <<Entity>> {
        - id : Long
        - tipoMotor : TipoMotorEnum
        - nombreRepresentativo : String
        - descripcionDetallada : String
        - parametroExacto : String
        - nivelSeveridad : NivelSeveridadEnum
        - ponderacion : int
        - activa : boolean
        + getId() : Long
        + getTipoMotor() : TipoMotorEnum
        + getNombreRepresentativo() : String
        + getPonderacion() : int
        + isActiva() : boolean
    }

    enum NivelSeveridadEnum {
        ALTA
        MEDIA
        BAJA
    }

    enum TipoMotorEnum {
        PRESENCIA_ARCHIVO
        RESTRICCION_ARCHIVOS
        ESTRUCTURA_CARPETAS
    }
}

' ========================================================
' RELACIONES ENTRE COMPONENTES Y CAPAS
' ========================================================

' Servlets a Servicios
ProyectoServlet --> ProyectoService : invoca
ReglaServlet --> ReglaService : invoca
AuditoriaServlet --> AuditoriaService : invoca

' Servicios a DAOs
ProyectoServiceImpl --> ProyectoDAO : utiliza
ReglaServiceImpl --> ReglaDAO : utiliza
AuditoriaServiceImpl --> AuditoriaDAO : utiliza
AuditoriaServiceImpl --> ReglaDAO : utiliza
AuditoriaServiceImpl --> ProyectoDAO : utiliza

' Servicios a Clientes y Fábrica de Estrategias
AuditoriaServiceImpl --> GitHubClient : invoca
AuditoriaServiceImpl --> EvaluadorReglaFactory : solicita
EvaluadorReglaFactory --> EvaluadorReglaStrategy : crea

' Relaciones del Modelo / Dominio
Auditoria --> Proyecto : evalua
Auditoria "1" *-- "many" ResultadoRegla : contiene
ResultadoRegla --> Regla : verifica
ResultadoRegla "1" o-- "0..1" Hallazgo : genera
Regla --> TipoMotorEnum : tipo
Regla --> NivelSeveridadEnum : severidad
Hallazgo --> NivelSeveridadEnum : severidad

' Disposición estructural y orden visual vertical
ProyectoServiceImpl -[hidden]down-> NuevaReglaDTO
NuevaReglaDTO -[hidden]right-> ProyectoDAO
ProyectoDAO -[hidden]right-> EvaluadorReglaFactory
EvaluadorReglaFactory -[hidden]right-> GitHubClient

AuditoriaDAOImpl -[hidden]down-> Auditoria

@enduml
