@startuml
skinparam style strictuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam shadowing false

' ========================================================
' ESTILOS VISUALES: CLASES VS INTERFACES VS ENUMS
' ========================================================
skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #94A3B8
    BorderThickness 1.0
    FontStyle bold
}

' Clases concretas (Azul sobrio)
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    BorderThickness 1.2
    HeaderBackgroundColor #EFF6FF
}

' Interfaces (Verde esmeralda para identificar contratos al instante)
skinparam interface {
    BackgroundColor #FFFFFF
    BorderColor #059669
    BorderThickness 1.5
    HeaderBackgroundColor #ECFDF5
}

' Enumeraciones (Ámbar cálido)
skinparam enum {
    BackgroundColor #FFFFFF
    BorderColor #D97706
    BorderThickness 1.2
    HeaderBackgroundColor #FFFBEB
}

skinparam arrow {
    Color #334155
    FontColor #334155
    Thickness 1.1
}

' ========================================================
' MÓDULO REGLAS
' ========================================================
package "reglas" {

    package "SERVLET" {
        class ReglaServlet {
            - reglaService : ReglaService
            # doGet(request : HttpServletRequest, response : HttpServletResponse) : void
            # doPost(request : HttpServletRequest, response : HttpServletResponse) : void
        }
    }

    package "SERVICE" {
        interface ReglaService {
            + registrarReglaEvaluacionTecnica(dto : NuevaReglaDTO) : void
        }

        class ReglaServiceImpl {
            - reglaDAO : ReglaDAO
            + registrarReglaEvaluacionTecnica(dto : NuevaReglaDTO) : void
            - validarSintaxisYFormato(dto : NuevaReglaDTO) : void
        }
    }

    package "DAO" {
        interface ReglaDAO {
            + existePorNombre(nombre : String) : boolean
            + guardar(regla : Regla) : void
        }

        class ReglaDAOImpl {
            + existePorNombre(nombre : String) : boolean
            + guardar(regla : Regla) : void
        }
    }

    package "DTO" {
        class NuevaReglaDTO {
            - tipoMotor : String
            - nombreRepresentativo : String
            - descripcionDetallada : String
            - parametroExacto : String
            - nivelSeveridad : String
            - ponderacion : int
            + NuevaReglaDTO(tipo: String, nombre: String, desc: String, param: String, sev: String, pond: int)
            + getTipoMotor() : String
            + getNombreRepresentativo() : String
            + getDescripcionDetallada() : String
            + getParametroExacto() : String
            + getNivelSeveridad() : String
            + getPonderacion() : int
        }
    }

    package "MODEL" {
        enum TipoMotor {
            PRESENCIA_ARCHIVO
            RESTRICCION_ARCHIVOS
            ESTRUCTURA_CARPETAS
        }

        enum NivelSeveridad {
            ALTA
            MEDIA
            BAJA
        }

        class Regla {
            - id : Long
            - tipoMotor : TipoMotor
            - nombreRepresentativo : String
            - descripcionDetallada : String
            - parametroExacto : String
            - nivelSeveridad : NivelSeveridad
            - ponderacion : int
            - activa : boolean
            + Regla(dto : NuevaReglaDTO)
            + getId() : Long
            + getTipoMotor() : TipoMotor
            + getNombreRepresentativo() : String
            + getDescripcionDetallada() : String
            + getParametroExacto() : String
            + getNivelSeveridad() : NivelSeveridad
            + getPonderacion() : int
            + isActiva() : boolean
            + setActiva(activa : boolean) : void
        }
    }
}

' ========================================================
' RELACIONES ESTRUCTURALES (ESPINAL DORSAL)
' ========================================================
ReglaServlet --> ReglaService : reglaService
ReglaServiceImpl ..|> ReglaService
ReglaServiceImpl --> ReglaDAO : reglaDAO
ReglaDAOImpl ..|> ReglaDAO

Regla --> TipoMotor : tipoMotor
Regla --> NivelSeveridad : nivelSeveridad

@enduml
