@startuml
skinparam style strictuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false

' Ajuste de espacio horizontal entre participantes
skinparam maxMessageSize 130
skinparam ParticipantPadding 10
skinparam BoxPadding 10

skinparam participant {
    BackgroundColor #F0F7FF
    BorderColor #1D4ED8
    BorderThickness 1.2
    FontColor #0F172A
    FontStyle bold
}

skinparam actor {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    BorderThickness 1.2
    FontColor #0F172A
}

skinparam sequence {
    LifeLineBackgroundColor #DBEAFE
    LifeLineBorderColor #2563EB
    ArrowColor #1D4ED8
    ArrowThickness 1.2
}

autonumber "<b>[00]</b>"

actor "estudiante" as estudiante
participant "vista :\nregistrarProyecto.jsp" as jsp
participant "servlet :\nProyectoServlet" as servlet
participant "dto :\nNuevoProyectoDTO" as dto
participant "servicio :\nProyectoServiceImpl" as service
participant "dao :\nProyectoDAOImpl" as dao
participant "proyecto :\nProyecto" as proyecto

' 1. El estudiante envía sus datos
estudiante -> jsp : escribirDatos( nombre, urlGithub)
activate jsp

' 2. La vista redirige al Servlet
jsp -> servlet : doPost( request, response)
activate servlet

servlet -> servlet : extraerParametros( request)

' 3. Creación del DTO
create dto
servlet -> dto : new( nombre,\n  urlGithub)

' 4. Invocación al servicio de negocio
servlet -> service : registrarProyecto(\n  dto,  estudianteId)
activate service

' 5. Validación interna del enlace
service -> service : validarEnlace(  dto.getUrlGithub())

alt ¿Enlace válido?
    ' 6. Creación y persistencia de la entidad
    create proyecto
    service -> proyecto : new(  dto.getNombre(),\n  dto.getUrlGithub())

    service -> dao : guardar(  proyecto)
    activate dao
    dao --> service : return (void)
    deactivate dao

    service --> servlet : return (void)
    deactivate service

    ' 7. Confirmación a la vista
    servlet -> servlet : setAttribute(\n  "mensajeConfirmacion",\n  "Proyecto registrado")
    
    servlet -> jsp : forward( request,\n  response)
    deactivate servlet

    jsp --> estudiante : renderizarExito(\n  "Registro del proyecto")
else ¿Enlace inválido?
    service --> servlet : throw ExcepcionNegocio( "Enlace no válido")
    servlet -> jsp : forwardConError(\n  "Error con el enlace")
    jsp --> estudiante : renderizarError(\n  "Error con el enlace")
end
deactivate jsp

@enduml