@startuml
skinparam style strictuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false

skinparam maxMessageSize 130
skinparam ParticipantPadding 10
skinparam BoxPadding 10

skinparam participant {
    BackgroundColor #F0F7FF
    BorderColor #1D4ED8
    BorderThickness 1.2
    FontColor #0F172A
    FontStyle bold
}

skinparam actor {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    BorderThickness 1.2
    FontColor #0F172A
}

skinparam sequence {
    LifeLineBackgroundColor #DBEAFE
    LifeLineBorderColor #2563EB
    ArrowColor #1D4ED8
    ArrowThickness 1.2
}

autonumber "<b>[00]</b>"

actor "estudiante" as estudiante
participant "servlet :\nProyectoServlet" as servlet
participant "servicio :\nProyectoServiceImpl" as service
participant "dao :\nProyectoDAOImpl" as dao
participant "proyecto :\nProyecto" as proyecto

' 1. La petición entra directo al Servlet desde el navegador
estudiante -> servlet : doPost(\n  request,\n  response)
activate servlet

' 2. El Servlet extrae los parámetros y crea internamente el DTO
servlet -> servlet : dto = extraerParametros(\n  request)

' 3. Se envía el DTO como parámetro al servicio
servlet -> service : registrarProyecto(\n  dto,\n  estudianteId)
activate service

' 4. Validación lógica del enlace
service -> service : validarEnlace(\n  dto.getUrlGithub())

alt ¿Enlace válido?
    ' 5. Instanciación y persistencia de la Entidad
    create proyecto
    service -> proyecto : new(\n  dto.getNombre(),\n  dto.getUrlGithub())

    service -> dao : guardar(\n  proyecto)
    activate dao
    dao --> service : return (void)
    deactivate dao

    service --> servlet : return (void)
    deactivate service

    ' 6. El Servlet realiza la respuesta/forward
    servlet --> estudiante : forward(\n  "mensajeExito")
else ¿Enlace inválido?
    service --> servlet : throw ExcepcionNegocio(\n  "Enlace no válido")
    servlet --> estudiante : forward(\n  "mensajeError")
end
deactivate servlet

@enduml