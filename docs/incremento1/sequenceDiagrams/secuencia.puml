@startuml
skinparam style strictuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false

skinparam participant {
    BackgroundColor #F0F7FF
    BorderColor #1D4ED8
    BorderThickness 1.2
    FontColor #0F172A
    FontStyle bold
}

skinparam actor {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    BorderThickness 1.2
    FontColor #0F172A
}

skinparam sequence {
    LifeLineBackgroundColor #DBEAFE
    LifeLineBorderColor #2563EB
    ArrowColor #1D4ED8
    ArrowThickness 1.2
}

autonumber "<b>[00]</b>"

actor "docente : Docente" as docente
participant "servlet : ReglaServlet" as servlet
participant "servicio : ReglaServiceImpl" as service
participant "dao : ReglaDAOImpl" as dao
participant "regla : Regla" as regla

' 1. El actor envía la petición HTTP al Servlet (Punto de entrada al backend)
docente -> servlet : doPost(request, response)
activate servlet

' 2. El Servlet procesa la petición y delega la ejecución de negocio
servlet -> service : registrarReglaEvaluacionTecnica(dto)
activate service

' 3. El Servicio ejecuta validaciones sintácticas en memoria
service -> service : validarSintaxisYFormato(dto)

' 4. El Servicio consulta al DAO para verificar unicidad
service -> dao : existePorNombre(dto.getNombreRepresentativo())
activate dao

dao --> service : false
deactivate dao

' 5. El Servicio instancia la entidad de dominio Regla
create regla
service -> regla : new(dto)

' 6. El Servicio persiste la entidad a través del DAO
service -> dao : guardar(regla)
activate dao

dao --> service : void
deactivate dao

' 7. El Servicio retorna el control con éxito al Servlet
service --> servlet : void
deactivate service

' 8. El Servlet redirige o responde al Docente con la vista de confirmación
servlet --> docente : forward("exito.jsp")
deactivate servlet

@enduml
